# =============================================================================
# .env.example — copy this to .env and fill in your real values
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── Google Gemini (LLM Engine) ────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model to use for all LLM extraction tasks (default: gemini-3.1-pro)
# Use gemini-3.1-pro for higher accuracy at slightly higher cost.
# GEMINI_MODEL=gemini-3.1-pro

# ── Scraper ───────────────────────────────────────────────────────────────────
# Path to the LinkedIn session cookie file (default: linkedin_cookies.pkl in cwd)
# COOKIES_PATH=linkedin_cookies.pkl

# ── Pipeline Usage Reference ──────────────────────────────────────────────────
#
# python pipeline.py \
#   --company-name         "igaps" \
#   --website-url          "https://www.igaps.ai/about" \
#   --founder-name         "Indranil Datta" \
#   --founder-email        "indranil@igaps.ai" \
#   --linkedin-url         "https://www.linkedin.com/company/igaps-ai/" \
#   --founder-linkedin-url "https://www.linkedin.com/in/indranil-datta" \
#   --dry-run
#
# Notes:
#   --website-url    accepts any URL; root domain is extracted automatically
#   --linkedin-url   company LinkedIn page (enables co-founder discovery)
#   --founder-linkedin-url  skip auto-discovery; use this profile directly

# ── Legacy / Old Pipeline Only ────────────────────────────────────────────────
# The following keys are only needed by main.py / enrichment_main.py.
# They are NOT used by pipeline.py (the new pipeline).

# Hunter.io API key (used by email_api.py in the old main.py pipeline)
# HUNTER_API_KEY=your-hunter-api-key-here

# Number of companies to process per batch run (old pipeline only)
# BATCH_SIZE=1
