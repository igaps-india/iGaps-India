digraph EvalTree {
  graph [rankdir=LR fontname="Helvetica" bgcolor="white" label="iGaps Evaluation Tree" labelloc=t fontsize=14]
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10]
  edge [fontname="Helvetica" fontsize=9]

  ROOT [label="iGaps Evaluation\nPass ≥ 40%" shape=diamond style=filled fillcolor="#6366f1" fontcolor=white]
  N_trackA [label="Founding Team\n[must_have] 35%\ntrackA" shape=box fillcolor="#dcfce7" fontsize=12]
  N_trackA_L1 [label="Lived Insight\n[must_have] 40%\ntrackA.L1" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackA_L1_insider_status [label="Insider status\n[required] 25%\ntrackA.L1.insider_status" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackA_L1_domain_immersion_years [label="Domain immersion duration\n[must_have] 20%\ntrackA.L1.domain_immersion_years" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L1_causality_chain_coherence [label="Causality chain coherence\n[must_have] 25%\ntrackA.L1.causality_chain_coherence" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L1_non_obvious_insight [label="Non-obvious insight\n[must_have] 25%\ntrackA.L1.non_obvious_insight" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L1_prefounding_engagement [label="Pre-founding public engagement\n[good_to_have] 5%\ntrackA.L1.prefounding_engagement" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackA_L2 [label="Team Chemistry\n[must_have] 20%\ntrackA.L2" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackA_L2_cofounder_known_duration [label="Co-founder known duration\n[required] 30%\ntrackA.L2.cofounder_known_duration" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackA_L2_relationship_type_strength [label="Relationship type strength\n[must_have] 30%\ntrackA.L2.relationship_type_strength" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L2_shared_history_verified [label="Shared history verified\n[must_have] 25%\ntrackA.L2.shared_history_verified" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L2_prior_venture_together [label="Prior venture together\n[good_to_have] 15%\ntrackA.L2.prior_venture_together" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackA_L3 [label="Founder Leverage\n[must_have] 25%\ntrackA.L3" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackA_L3_first10_source [label="Source of first 10 customers\n[must_have] 30%\ntrackA.L3.first10_source" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L3_cac_first10 [label="CAC for first 10 customers\n[must_have] 20%\ntrackA.L3.cac_first10" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L3_leverage_specificity [label="Leverage specificity\n[must_have] 30%\ntrackA.L3.leverage_specificity" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L3_network_density [label="Network density in AI sector\n[good_to_have] 20%\ntrackA.L3.network_density" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackA_L4 [label="Execution Velocity\n[must_have] 15%\ntrackA.L4" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackA_L4_pivot_history [label="Pivot history\n[required] 20%\ntrackA.L4.pivot_history" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackA_L4_pivot_quality [label="Pivot quality\n[must_have] 30%\ntrackA.L4.pivot_quality" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L4_github_velocity [label="GitHub build velocity\n[must_have] 25%\ntrackA.L4.github_velocity" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackA_L4_incorporation_to_traction_days [label="Days from incorporation to first traction\n[good_to_have] 15%\ntrackA.L4.incorporation_to_traction_days" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackA_L4_press_velocity [label="Press velocity\n[not_required] 10%\ntrackA.L4.press_velocity" shape=ellipse fillcolor="#f3f4f6" fontsize=9]
  N_trackB [label="Problem and Market\n[must_have] 25%\ntrackB" shape=box fillcolor="#dcfce7" fontsize=12]
  N_trackB_L1 [label="Problem Definition and Severity\n[must_have] 30%\ntrackB.L1" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackB_L1_problem_in_customer_words [label="Problem in customer words\n[must_have] 40%\ntrackB.L1.problem_in_customer_words" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L1_problem_severity_quant [label="Problem severity quantification\n[must_have] 30%\ntrackB.L1.problem_severity_quant" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L1_persona_spend_on_workarounds [label="Persona spend on workarounds\n[required] 30%\ntrackB.L1.persona_spend_on_workarounds" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackB_L2 [label="Stakeholder Mapping and Customer Discovery\n[must_have] 20%\ntrackB.L2" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackB_L2_discovery_breadth [label="Discovery breadth\n[must_have] 50%\ntrackB.L2.discovery_breadth" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L2_discovery_quality [label="Discovery quality\n[must_have] 50%\ntrackB.L2.discovery_quality" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L3 [label="Persona Definition\n[must_have] 20%\ntrackB.L3" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackB_L3_persona_role_specificity [label="Persona role specificity\n[required] 30%\ntrackB.L3.persona_role_specificity" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackB_L3_persona_segment_type [label="Persona segment type\n[must_have] 20%\ntrackB.L3.persona_segment_type" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L3_persona_vividity [label="Persona vividity\n[must_have] 50%\ntrackB.L3.persona_vividity" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L4 [label="Need Gap\n[must_have] 20%\ntrackB.L4" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackB_L4_need_gap_precision [label="Need gap precision\n[must_have] 60%\ntrackB.L4.need_gap_precision" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackB_L4_failed_alternatives_mapped [label="Failed alternatives mapped\n[good_to_have] 40%\ntrackB.L4.failed_alternatives_mapped" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackB_L5 [label="Market Sizing\n[must_have] 10%\ntrackB.L5" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackB_L5_persona_count_with_source [label="Persona count with source\n[required] 60%\ntrackB.L5.persona_count_with_source" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackB_L5_sam_calculation_derived [label="SAM calculation derived\n[must_have] 40%\ntrackB.L5.sam_calculation_derived" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC [label="Solution\n[must_have] 20%\ntrackC" shape=box fillcolor="#dcfce7" fontsize=12]
  N_trackC_L1 [label="Solution Definition\n[must_have] 20%\ntrackC.L1" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackC_L1_solution_in_persona_words [label="Solution in persona words\n[must_have] 50%\ntrackC.L1.solution_in_persona_words" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L1_trl_level [label="Technology Readiness Level\n[required] 50%\ntrackC.L1.trl_level" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackC_L2 [label="Differentiation\n[must_have] 25%\ntrackC.L2" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackC_L2_differentiation_dimension [label="Differentiation dimension\n[required] 40%\ntrackC.L2.differentiation_dimension" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackC_L2_improvement_multiple [label="Improvement multiple\n[must_have] 30%\ntrackC.L2.improvement_multiple" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L2_switching_reason_specificity [label="Switching reason specificity\n[must_have] 30%\ntrackC.L2.switching_reason_specificity" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L3 [label="Impact and Value\n[must_have] 20%\ntrackC.L3" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackC_L3_impact_multiple_evidence [label="Impact multiple evidence\n[must_have] 100%\ntrackC.L3.impact_multiple_evidence" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L4 [label="Technical Credibility\n[must_have] 20%\ntrackC.L4" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackC_L4_github_signals [label="GitHub signals\n[must_have] 40%\ntrackC.L4.github_signals" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L4_hard_problem_articulation [label="Hard problem articulation\n[must_have] 40%\ntrackC.L4.hard_problem_articulation" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L4_pitch_deck_tech_coherence [label="Pitch deck technical coherence\n[good_to_have] 20%\ntrackC.L4.pitch_deck_tech_coherence" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackC_L5 [label="Moat\n[must_have] 15%\ntrackC.L5" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackC_L5_moat_category [label="Moat category\n[required] 30%\ntrackC.L5.moat_category" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackC_L5_moat_compounding_evidence [label="Moat compounding evidence\n[must_have] 40%\ntrackC.L5.moat_compounding_evidence" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackC_L5_patent_filings [label="Patent filings\n[good_to_have] 30%\ntrackC.L5.patent_filings" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackD [label="Traction and Validation\n[must_have] 20%\ntrackD" shape=box fillcolor="#dcfce7" fontsize=12]
  N_trackD_L1 [label="Traction\n[must_have] 50%\ntrackD.L1" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackD_L1_traction_stack_position [label="Traction stack position\n[required] 60%\ntrackD.L1.traction_stack_position" shape=ellipse fillcolor="#fef9c3" fontsize=9]
  N_trackD_L1_branching_traction_metric [label="Sector-specific traction metric\n[must_have] 30%\ntrackD.L1.branching_traction_metric" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackD_L1_market_proof [label="Market proof\n[must_have] 10%\ntrackD.L1.market_proof" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackD_L2 [label="Validation\n[must_have] 50%\ntrackD.L2" shape=box fillcolor="#dcfce7" fontsize=10]
  N_trackD_L2_organic_demand_signal [label="Organic demand signal\n[must_have] 40%\ntrackD.L2.organic_demand_signal" shape=ellipse fillcolor="#dcfce7" fontsize=9]
  N_trackD_L2_pitch_deck_traction_claims [label="Pitch deck traction claims\n[good_to_have] 30%\ntrackD.L2.pitch_deck_traction_claims" shape=ellipse fillcolor="#dbeafe" fontsize=9]
  N_trackD_L2_customer_initiated_evidence [label="Customer-initiated evidence\n[must_have] 30%\ntrackD.L2.customer_initiated_evidence" shape=ellipse fillcolor="#dcfce7" fontsize=9]

  ROOT -> N_trackA [label="35%" penwidth=2]
  ROOT -> N_trackB [label="25%" penwidth=2]
  ROOT -> N_trackC [label="20%" penwidth=2]
  ROOT -> N_trackD [label="20%" penwidth=2]
  N_trackA -> N_trackA_L1 [label="40%"]
  N_trackA_L1 -> N_trackA_L1_insider_status [label="25%"]
