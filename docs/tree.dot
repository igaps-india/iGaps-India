  N_trackA_L1 -> N_trackA_L1_non_obvious_insight [label="25%"]
  N_trackA_L1 -> N_trackA_L1_prefounding_engagement [label="5%"]
  N_trackA -> N_trackA_L2 [label="20%"]
  N_trackA_L2 -> N_trackA_L2_cofounder_known_duration [label="30%"]
  N_trackA_L2 -> N_trackA_L2_relationship_type_strength [label="30%"]
