# ── Database ──────────────────────────────────────────────────────────────────
# Use the SAME host your backend logs on startup ([DB] Using ...).
# On Windows you may have TWO MongoDB servers on port 27017 (127.0.0.1 vs ::1).
# If mongosh returns null but the app works, try: mongosh "mongodb://[::1]:27017/igaps"
MONGODB_URI=mongodb://127.0.0.1:27017/igaps

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
MAGIC_LINK_EXPIRES_MINUTES=20160

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@igaps.in

# ── Storage (Cloudflare R2 / S3-compatible) ────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=igaps-uploads
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro
# Override per task (optional):
# GEMINI_MODEL_RUBRIC=gemini-3.1-pro
# GEMINI_MODEL_AGENT=gemini-3.1-pro

# ── Scraping ──────────────────────────────────────────────────────────────────
# ZaubaCorp CIN scrape (Step 1) — runs on intake, no API key needed
ZAUBA_BASE_URL=https://www.zaubacorp.com

# Step 2 — LinkedIn microservice (separate branch; leave empty until merged)
# LINKEDIN_SCRAPER_URL=http://localhost:3002

# Legacy optional scrapers (not enqueued on intake in MVP)
PROXYCURL_API_KEY=your_proxycurl_key
SERPAPI_KEY=your_serpapi_key
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Queue ─────────────────────────────────────────────────────────────────────
# 'inmemory' (default for MVP) or 'valkey'
QUEUE_PROVIDER=inmemory
# Only needed if QUEUE_PROVIDER=valkey:
# VALKEY_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_NAME=iGaps

# ── Scoring ───────────────────────────────────────────────────────────────────
# Default pass threshold (overridden by active BiasProfile in DB)
DEFAULT_PASS_THRESHOLD=40

# ── Features ──────────────────────────────────────────────────────────────────
# KNN-Grounded Signal Scoring (Part of Phase 4 — see docs/KNN_GROUNDING.md)
# Set to false until backfillSignalExamples.ts has been run against confirmed evals.
# Enable in staging first, review 5-10 evaluations, then enable in production.
KNN_GROUNDING_ENABLED=false

# Base URL of the Python scoring/scraping microservice.
# Change this if the microservice runs on a different host (e.g. Docker Compose).
PYTHON_MICROSERVICE_URL=http://127.0.0.1:8000
